+     * shelf's ImageView crops to the screen; null when the theme has none or it cannot be read.
+     */
+    static Bitmap photo(File themeDir, String pkg) {
+        if (themeDir == null || pkg == null) return null;
+        File f = new File(new File(themeDir, ThemeFiles.ART), pkg + ".jpg");
+        if (!f.isFile()) return null;
+        BitmapFactory.Options bounds = new BitmapFactory.Options();
+        bounds.inJustDecodeBounds = true;
+        BitmapFactory.decodeFile(f.getPath(), bounds);
+        if (bounds.outWidth <= 0) return null;
+        BitmapFactory.Options o = new BitmapFactory.Options();
+        o.inPreferredConfig = Bitmap.Config.RGB_565;
+        while (bounds.outWidth / (o.inSampleSize == 0 ? 1 : o.inSampleSize) > 1920) {
+            o.inSampleSize = o.inSampleSize == 0 ? 2 : o.inSampleSize * 2;
+        }
+        Bitmap b = BitmapFactory.decodeFile(f.getPath(), o);
+        if (b == null || b.getWidth() <= 960) return b;
+        Bitmap scaled = Bitmap.createScaledBitmap(b, 960, Math.max(1, b.getHeight() * 960 / b.getWidth()), true);
+        if (scaled != b) b.recycle();
+        return scaled;
+    }
