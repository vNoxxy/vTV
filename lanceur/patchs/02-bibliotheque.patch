+    /**
+     * vTV: the focused card lifts, Apple TV style: it grows, brightens and takes a bright rim, with
+     * an eased 180 ms motion (none with reduced motion or without animations).
+     */
+    private void lift(View card, boolean focused, boolean animate) {
+        float scale = focused ? 1.1f : 1f;
+        card.setZ(focused ? dp(8) : 0);
+        if (card.getBackground() instanceof GradientDrawable) {
+            GradientDrawable bg = (GradientDrawable) card.getBackground();
+            bg.setStroke(dp(focused ? 2 : 1), focused ? 0xCCFFFFFF : 0x18FFFFFF);
+        }
+        card.animate().cancel();
+        if (!animate || !animations || reducedMotion) {
+            card.setScaleX(scale);
+            card.setScaleY(scale);
+            card.setAlpha(1f);
+            return;
+        }
+        card.animate().scaleX(scale).scaleY(scale).setDuration(180)
+                .setInterpolator(new android.view.animation.DecelerateInterpolator(1.6f)).start();
+    }
+
