diff --git a/launcher/app/src/main/res/animator/settings_lift.xml b/launcher/app/src/main/res/animator/settings_lift.xml
new file mode 100644
index 00000000..fef5ff2d
--- /dev/null
+++ b/launcher/app/src/main/res/animator/settings_lift.xml
@@ -0,0 +1,20 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- vTV: the focused row grows a little, eased, like a tvOS list. -->
+<selector xmlns:android="http://schemas.android.com/apk/res/android">
+    <item android:state_focused="true">
+        <set>
+            <objectAnimator android:propertyName="scaleX" android:valueTo="1.03" android:duration="160"
+                android:interpolator="@android:interpolator/decelerate_quad" />
+            <objectAnimator android:propertyName="scaleY" android:valueTo="1.03" android:duration="160"
+                android:interpolator="@android:interpolator/decelerate_quad" />
+        </set>
+    </item>
+    <item>
+        <set>
+            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:duration="160"
+                android:interpolator="@android:interpolator/decelerate_quad" />
+            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:duration="160"
+                android:interpolator="@android:interpolator/decelerate_quad" />
+        </set>
+    </item>
+</selector>
